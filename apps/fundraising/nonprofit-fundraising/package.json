  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2"
  },
  "keywords": [
    "twenty-app"
  ],
  "packageManager": "yarn@4.13.0",
  "scripts": {
