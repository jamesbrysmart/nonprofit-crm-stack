{
  "name": "nonprofit-fundraising",
  "version": "0.1.14",
  "license": "MIT",
  "engines": {
    "node": "^24.5.0 || ^26.5.1",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2",
    "twenty": ">=2.59.0"
  },
  "keywords": [
    "twenty-app"
  ],
  "packageManager": "yarn@4.18.1",
  "scripts": {
    "twenty": "twenty",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint --fix -c .oxlintrc.json .",
    "stripe:fixtures": "node scripts/stripe-intake-fixtures.mjs",
    "typecheck": "tsgo --noEmit -p tsconfig.spec.json",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "stripe": "22.1.1",
    "uuid": "13.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260116.1",
    "oxlint": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twenty-client-sdk": "2.59.0",
    "twenty-sdk": "2.59.0",
    "twenty-ui": "2.59.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.1.12"
  },
  "frontComponentSharedDependencies": [
    "react",
    "react-dom/client",
    "twenty-ui/components/feedback",
    "twenty-ui/components/input",
    "twenty-ui/primitives/input",
    "twenty-ui/primitives/typography"
  ]
