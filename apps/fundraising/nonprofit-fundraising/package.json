    "test:watch": "vitest"
  },
  "dependencies": {
    "stripe": "22.1.1",
    "uuid": "13.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.0.0",
    "oxlint": "^0.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "twenty-client-sdk": "2.45.0",
    "twenty-sdk": "2.45.0",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^4.2.1",
    "vitest": "^4.0.0"
  }
